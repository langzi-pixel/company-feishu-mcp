NODE_ENV=production
# Fill the actual public HTTPS origin after the domain and certificate are ready.
PUBLIC_ORIGIN=
BASE_PATH=/feishu
PORT=8080
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Include the actual approved user scopes as well as offline_access.
FEISHU_SCOPES=
FEISHU_ALLOWED_USERS=
# Copy the exact redirect URI shown by the MCP client.
OAUTH_REDIRECT_URIS=
STATE_STORE=sqlite
STATE_DB_PATH=/data/state.sqlite
# Generate once: openssl rand -base64 32. Keep this key outside the repository.
STATE_ENCRYPTION_KEY=
